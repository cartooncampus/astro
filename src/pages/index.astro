---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeCard from '../components/HomeCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION, MAIN_SECTIONS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-content {
				text-align: center;
				margin-bottom: 4rem;
				padding: 3rem 1rem;
				background: linear-gradient(135deg, rgba(124, 58, 237, 0.08) 0%, rgba(37, 99, 235, 0.08) 100%);
				border-radius: 20px;
				border: 1px solid rgba(124, 58, 237, 0.15);
				backdrop-filter: blur(10px);
			}

			.hero-content h1 {
				background: linear-gradient(135deg, #7c3aed 0%, #2563eb 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				margin-bottom: 1rem;
				font-size: 3.5rem;
				font-weight: 800;
				letter-spacing: -0.02em;
			}

			.hero-content .subtitle {
				font-size: 1.25rem;
				color: rgb(var(--gray-dark));
				max-width: 700px;
				margin: 0 auto 1.5rem;
				line-height: 1.8;
			}

			.hero-content .tagline {
				font-size: 1rem;
				color: var(--accent);
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin-bottom: 1rem;
			}

			.home-sections {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
				gap: 2.5rem;
				margin-top: 3rem;
				margin-bottom: 4rem;
			}

			.section-description {
				text-align: center;
				color: rgb(var(--gray-dark));
				font-size: 1.1rem;
				max-width: 800px;
				margin: 2rem auto;
				line-height: 1.8;
			}

			@media (max-width: 768px) {
				.hero-content {
					padding: 2rem 1rem;
				}

				.hero-content h1 {
					font-size: 2.5rem;
				}

				.hero-content .subtitle {
					font-size: 1.1rem;
				}

				.home-sections {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-content">
				<p class="tagline">Welcome to</p>
				<h1>Infinite Futures, Infinite Campuses</h1>
				<h3>Find Your Place in the Multiverse of Academia</h3>

				<p class="subtitle">
					The premier interdimensional admissions guidance service matching prospective scholars with institutions across realities, 
					timelines, and narrative continuities.
				</p>
				<p class="subtitle">For generations, scholars across fiction-space have faced the ultimate question: Where do you truly belong? 
				Whether you are calculating galactic trajectories on Trantor, decoding forbidden tomes in New England, 
				mastering elemental philosophy, or searching for real-world higher education, your academic journey begins here.
				</p>
				<p class="subtitle"> At Cartoon Campus, we believe the right university doesn't just shape your career—it can determine 
				the fate of an entire galaxy!
				</p>
			</section>

			<p class="section-description">
				Choose your adventure below and dive into one of our three main hubs:
			</p>

			<div class="home-sections">
				{MAIN_SECTIONS.map((section) => (
					<HomeCard
						title={section.title}
						subtitle={section.subtitle}
						description={section.description}
						icon={section.icon}
						color={section.color}
						href={section.href}
					/>
				))}
			</div>

			<section style="text-align: center; margin-top: 4rem; padding-top: 3rem; border-top: 2px solid rgba(124, 58, 237, 0.1);">
				<h2 style="font-size: 2rem; margin-bottom: 1.5rem;">Get Started</h2>
				<p style="font-size: 1.1rem; color: rgb(var(--gray-dark)); max-width: 600px; margin: 1rem auto;">
					Whether you're a fan of science fiction, a curious student, a sports enthusiast, or someone looking 
					to connect with our community, CartoonCampus has something for you. Pick a section above and begin your journey!
				</p>
				<div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
					<a href="/fictional-worlds" style="display: inline-block; padding: 0.75rem 2rem; background: linear-gradient(135deg, #7c3aed, #6d28d9); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease; border: none;">
						Explore Fictional Worlds
					</a>
					<a href="/real-world" style="display: inline-block; padding: 0.75rem 2rem; background: linear-gradient(135deg, #2563eb, #1e40af); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease; border: none;">
						Browse Real Universities
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
