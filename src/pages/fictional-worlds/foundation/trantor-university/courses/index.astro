---
import BaseHead from '../../../../../components/BaseHead.astro';
import CourseCatalog from '../../../../../components/CourseCatalog.astro';
import Footer from '../../../../../components/Footer.astro';
import Header from '../../../../../components/Header.astro';
import { trantorUniversity } from '../../../../../data/fictionalUniversities';

const university = trantorUniversity;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Course Catalog - ${university.name} | CartoonCampus`} description={`Explore featured courses at ${university.name}.`} />
	</head>
	<body>
		<Header />
		<main><CourseCatalog university={university} /></main>
		<Footer />
	</body>
</html>
