---
import BaseHead from '../../components/BaseHead.astro';
import AboutContact from '../../components/AboutContact.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Multiverse - CartoonCampus"
			description="Explore multiversal universities across the greatest sci-fi and fantasy universes. From Miskatonic to Ba Sing Se, find your fictional alma mater."
		/>
		<style>
			.fictional-hero {
				text-align: center;
				margin-bottom: 4rem;
				padding: 4rem 2rem;
				background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(37, 99, 235, 0.1) 100%);
				border-radius: 20px;
				border: 2px solid rgba(124, 58, 237, 0.2);
				position: relative;
				overflow: hidden;
			}

			.fictional-hero::before {
				content: '';
				position: absolute;
				top: -50%;
				right: -50%;
				width: 200%;
				height: 200%;
				background: radial-gradient(circle, rgba(124, 58, 237, 0.05) 0%, transparent 70%);
				animation: float 20s ease-in-out infinite;
			}

			@keyframes float {
				0%, 100% {
					transform: translate(0, 0);
				}
				50% {
					transform: translate(30px, 30px);
				}
			}

			.fictional-hero h1 {
				background: linear-gradient(135deg, #7c3aed 0%, #2563eb 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				margin-bottom: 1rem;
				font-size: 3.5rem;
				position: relative;
				z-index: 2;
			}

			.fictional-hero .tagline {
				font-size: 1.25rem;
				color: rgb(var(--gray-dark));
				max-width: 700px;
				margin: 0 auto 1.5rem;
				line-height: 1.8;
				position: relative;
				z-index: 2;
			}

			.fictional-hero .intro {
				font-size: 1rem;
				color: rgb(var(--gray-dark));
				max-width: 800px;
				margin: 0 auto;
				line-height: 1.7;
				position: relative;
				z-index: 2;
			}

			.universes-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 2rem;
				margin-bottom: 4rem;
			}

			.universe-card {
				display: flex;
				flex-direction: column;
				text-decoration: none;
				border-radius: 16px;
				padding: 2rem;
				min-height: 300px;
				transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
				position: relative;
				overflow: hidden;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
				border: 1px solid rgba(0, 0, 0, 0.05);
				background: white;
			}

			.universe-card:hover {
				transform: translateY(-8px);
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
			}

			.universe-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 4px;
				background: linear-gradient(90deg, var(--card-accent-1, #7c3aed), var(--card-accent-2, #2563eb));
			}

			.universe-card.lovecraft {
				--card-accent-1: #7c3aed;
				--card-accent-2: #4c1d95;
			}

			.universe-card.foundation {
				--card-accent-1: #2563eb;
				--card-accent-2: #1e40af;
			}

			.universe-card.dune {
				--card-accent-1: #ea580c;
				--card-accent-2: #c2410c;
			}

			.universe-card.avatar {
				--card-accent-1: #059669;
				--card-accent-2: #047857;
			}

			.card-icon {
				font-size: 3rem;
				margin-bottom: 1rem;
			}

			.card-title {
				font-size: 1.5rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.5rem;
			}

			.card-source {
				font-size: 0.875rem;
				color: var(--accent);
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				margin-bottom: 1rem;
			}

			.card-description {
				flex: 1;
				font-size: 0.95rem;
				line-height: 1.6;
				color: rgb(var(--gray-dark));
				margin-bottom: 1.5rem;
			}

			.card-institutions {
				font-size: 0.85rem;
				color: var(--accent);
				margin-bottom: 1rem;
				font-weight: 500;
			}

			.explore-btn {
				display: inline-block;
				padding: 0.75rem 1.5rem;
				background: linear-gradient(135deg, var(--card-accent-1, #7c3aed), var(--card-accent-2, #2563eb));
				color: white;
				text-decoration: none;
				border-radius: 8px;
				font-weight: 600;
				transition: all 0.3s ease;
				align-self: flex-start;
			}

			.explore-btn:hover {
				transform: translateX(4px);
				box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
			}

			.cta-section {
				text-align: center;
				padding: 3rem 2rem;
				background: linear-gradient(135deg, rgba(124, 58, 237, 0.08) 0%, rgba(37, 99, 235, 0.08) 100%);
				border-radius: 16px;
				margin-top: 4rem;
				border: 1px solid rgba(124, 58, 237, 0.15);
			}

			.cta-section h2 {
				font-size: 2.2rem;
				margin-bottom: 1rem;
			}

			.cta-section p {
				font-size: 1.1rem;
				color: rgb(var(--gray-dark));
				max-width: 600px;
				margin: 1rem auto;
				line-height: 1.8;
			}

			.store-btn {
				display: inline-block;
				margin-top: 1.5rem;
				padding: 0.875rem 2rem;
				background: linear-gradient(135deg, #7c3aed, #6d28d9);
				color: white;
				text-decoration: none;
				border-radius: 8px;
				font-weight: 600;
				transition: all 0.3s ease;
			}

			.store-btn:hover {
				transform: translateY(-2px);
				box-shadow: 0 12px 30px rgba(124, 58, 237, 0.4);
			}

			@media (max-width: 768px) {
				.fictional-hero {
					padding: 2.5rem 1.5rem;
				}

				.fictional-hero h1 {
					font-size: 2.5rem;
				}

				.fictional-hero .tagline {
					font-size: 1.1rem;
				}

				.universes-grid {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}

				.cta-section h2 {
					font-size: 1.75rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="fictional-hero">
				<h1>🌌 Infinite Futures, Infinite Campuses</h1>
				<p class="tagline">Find the university that fits your destiny — whether you’re bound for the Core Worlds, the Spirit Realm, or somewhere beyond known reality.</p>
				<p class="intro">
					Welcome to the multiverse's premier educational network. Whether you're drawn to the cosmic 
					horrors of Lovecraft's Arkham, the psychohistorical empires of Asimov's Foundation, the 
					spice-laden deserts of Dune, or the earthen traditions of Avatar's Ba Sing Se, CartoonCampus 
					has your fictional alma mater. Explore hilarious syllabi, survival guides, and gear yourself 
					up with official campus merchandise.
				</p>
			</section>

			<section class="universes-grid">
				<!-- Lovecraft Mythos -->
				<a href="/multiverse/lovecraft/arkham/" class="universe-card lovecraft">
					<div class="card-icon">👁️</div>
					<h3 class="card-title">Lovecraft Mythos</h3>
					<p class="card-source">H.P. Lovecraft</p>
					<p class="card-description">
						Delve into forbidden knowledge and cosmic horror. Master eldritch languages, dangerous 
						zoology, and the art of reading from dangerous tomes without losing your sanity.
					</p>
					<p class="card-institutions">📍 Miskatonic University, Arkham MA</p>
					<span class="explore-btn">Explore →</span>
				</a>

				<!-- Foundation Series -->
				<a href="/multiverse/foundation/trantor/" class="universe-card foundation">
					<div class="card-icon">🌌</div>
					<h3 class="card-title">Foundation Series</h3>
					<p class="card-source">Isaac Asimov</p>
					<p class="card-description">
						Master psychohistory, imperial politics, and galactic mathematics. Shape the destiny of 
						trillions through prediction, strategy, and mathematical precision.
					</p>
					<p class="card-institutions">📍 Streeling & University of Trantor</p>
					<span class="explore-btn">Explore →</span>
				</a>

				<!-- Dune -->
				<a href="/multiverse/dune/arrakis/" class="universe-card dune">
					<div class="card-icon">🏜️</div>
					<h3 class="card-title">Dune Universe</h3>
					<p class="card-source">Frank Herbert</p>
					<p class="card-description">
						Survive the harshest world humanity has ever tamed. Learn ecology, politics, and the 
						secrets of the spice that keeps galactic commerce flowing.
					</p>
					<p class="card-institutions">📍 Arrakis University, Arrakeen</p>
					<span class="explore-btn">Explore →</span>
				</a>

				<!-- Avatar: The Last Airbender -->
				<a href="/multiverse/avatar/ba-sing-se/" class="universe-card avatar">
					<div class="card-icon">🏔️</div>
					<h3 class="card-title">Avatar Universe</h3>
					<p class="card-source">Avatar: The Last Airbender</p>
					<p class="card-description">
						Master earthbending, explore 4,000 years of history, and learn how to build a society 
						that values all citizens, benders and non-benders alike.
					</p>
					<p class="card-institutions">📍 University of Ba Sing Se, Earth Kingdom</p>
					<span class="explore-btn">Explore →</span>
				</a>
			</section>

			<section class="cta-section">
				<h2>Show Your Allegiance</h2>
				<p>
					Whether you're a proud Miskatonic alumnus, a psychohistorian from Trantor, a desert survivor from Arrakis, 
					or an earthbender from Ba Sing Se, we have official campus gear that celebrates your fictional university.
				</p>
				<p style="font-size: 0.95rem; color: var(--accent); font-weight: 600;">
					Browse our collection of hoodies, t-shirts, mugs, and accessories designed to honor the academic traditions 
					of your favorite fictional institution.
				</p>
				<a href="https://store.cartooncampus.ca/fictional-worlds" class="store-btn">
					Shop Multiverse Merch
				</a>
			</section>
		</main>
		<AboutContact />
		<Footer />
	</body>
</html>
