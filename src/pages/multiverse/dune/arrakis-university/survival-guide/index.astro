---
import BaseHead from '../../../../../components/BaseHead.astro';
import Footer from '../../../../../components/Footer.astro';
import Header from '../../../../../components/Header.astro';
import SurvivalGuide from '../../../../../components/SurvivalGuide.astro';
import { arrakisUniversity } from '../../../../../data/multiverseUniversities';

const university = arrakisUniversity;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Survival Guide - ${university.name} | CartoonCampus`}
			description={`Everything you need to know about attending ${university.name}. Compatibility, environmental hazards, and survival tips.`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<SurvivalGuide university={university} />
		</main>
		<Footer />
	</body>
</html>
