---
interface Props {
	title: string;
	subtitle: string;
	description: string;
	icon: string;
	color: string;
	href: string;
}

const { title, subtitle, description, icon, color, href } = Astro.props;
---

<a href={href} class={`home-card bg-gradient-to-br ${color}`}>
	<div class="card-content">
		<div class="card-header">
			<span class="card-icon">{icon}</span>
			<div class="card-titles">
				<h2 class="card-title">{title}</h2>
				<p class="card-subtitle">{subtitle}</p>
			</div>
		</div>
		<p class="card-description">{description}</p>
		<div class="card-cta">
			<span class="cta-text">Explore →</span>
		</div>
	</div>
</a>

<style>
	.home-card {
		display: block;
		text-decoration: none;
		border-radius: 16px;
		padding: 2.5rem;
		min-height: 320px;
		transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
		position: relative;
		overflow: hidden;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
		border: 1px solid rgba(255, 255, 255, 0.2);
	}

	.home-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: rgba(255, 255, 255, 0.1);
		transition: left 0.3s ease;
		z-index: 1;
	}

	.home-card:hover::before {
		left: 100%;
	}

	.card-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		height: 100%;
		color: white;
	}

	.card-header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.card-icon {
		font-size: 3rem;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 80px;
		height: 80px;
		background: rgba(255, 255, 255, 0.15);
		border-radius: 12px;
		backdrop-filter: blur(10px);
	}

	.card-titles {
		flex: 1;
	}

	.card-title {
		margin: 0;
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.2;
		color: white;
	}

	.card-subtitle {
		margin: 0.5rem 0 0 0;
		font-size: 0.875rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.85);
		letter-spacing: 0.5px;
		text-transform: uppercase;
	}

	.card-description {
		flex: 1;
		margin: 1rem 0;
		font-size: 1rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.9);
	}

	.card-cta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		color: white;
		transition: transform 0.3s ease;
	}

	.home-card:hover .card-cta {
		transform: translateX(8px);
	}

	.cta-text {
		font-size: 1rem;
	}

	@media (max-width: 768px) {
		.home-card {
			padding: 2rem;
			min-height: 300px;
		}

		.card-icon {
			min-width: 64px;
			height: 64px;
			font-size: 2.5rem;
		}

		.card-title {
			font-size: 1.5rem;
		}

		.card-description {
			font-size: 0.95rem;
		}
	}
</style>
