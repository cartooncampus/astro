---
import CourseCard from './CourseCard.astro';
import type { FictionalUniversity } from '../data/fictionalUniversities';

interface Props {
	university: FictionalUniversity;
}

const { university } = Astro.props;
---

<style>
	.back-link { color: var(--accent); display: inline-block; font-weight: 600; margin-bottom: 2rem; padding: 0.5rem 1rem; text-decoration: none; }
	.back-link:hover { transform: translateX(-4px); }
	.hero, .intro, .cta { border-radius: 12px; padding: 2rem; }
	.hero { background: linear-gradient(135deg, rgba(37, 99, 235, 0.15), rgba(30, 64, 175, 0.1)); border: 2px solid rgba(37, 99, 235, 0.2); margin-bottom: 2rem; text-align: center; }
	.hero h1, .intro h2, .course-title, .cta h2 { color: rgb(var(--black)); }
	.hero h1 { font-size: 2.5rem; margin: 0 0 1rem; }
	.hero p, .intro p, .intro li, .cta p { color: rgb(var(--gray-dark)); line-height: 1.7; }
	.intro { background: white; border-left: 4px solid var(--accent); margin-bottom: 2rem; }
	.intro h2 { margin-top: 0; }
	.intro ul { padding-left: 2rem; }
	.course-title { border-bottom: 2px solid rgba(37, 99, 235, 0.2); font-size: 1.5rem; margin: 2.5rem 0 1.5rem; padding-bottom: 1rem; }
	.cta { background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(30, 64, 175, 0.1)); border: 2px solid var(--accent); margin-top: 3rem; text-align: center; }
	.cta h2 { margin-top: 0; }
	.store-link { background: linear-gradient(135deg, #2563eb, #1e40af); border-radius: 8px; color: white; display: inline-block; font-weight: 600; padding: 0.75rem 2rem; text-decoration: none; }
	@media (max-width: 768px) { .hero h1 { font-size: 1.75rem; } }
</style>

<a href="../" class="back-link">← Back to {university.shortName}</a>
<section class="hero">
	<h1>📚 Course Catalog</h1>
	<p>Explore featured courses at {university.name}, designed to prepare you for a future in {university.universe}.</p>
</section>
<section class="intro">
	<h2>Welcome to Our Curriculum</h2>
	<p>Each course challenges your intellect and develops the skills needed to navigate a changing galaxy.</p>
	<ul>
		<li><strong>Credits:</strong> semester credit value</li>
		<li><strong>Difficulty:</strong> rated from 1 to 5</li>
		<li><strong>Survival Rate:</strong> students completing without major incident</li>
		<li><strong>Prerequisites:</strong> recommended preparation before enrolling</li>
	</ul>
</section>
<section>
	<h2 class="course-title">Featured Courses</h2>
	{university.courses.map((course) => (
		<CourseCard {...course} storeLink={university.storeLink} />
	))}
</section>
<section class="cta">
	<h2>Show Your Academic Pride</h2>
	<p>Celebrate your studies at {university.name} with official apparel and campus merchandise.</p>
	<a href={university.storeLink} target="_blank" rel="noopener noreferrer" class="store-link">Shop Official {university.shortName} Merch</a>
</section>
