---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
	highlights: string[];
	icon: string;
	theme: 'real-world' | 'other-stuff';
}

const { eyebrow, title, description, highlights, icon, theme } = Astro.props;
---

<main class={`construction-page ${theme}`}>
	<section class="construction-hero" aria-labelledby="page-title">
		<div class="hero-copy">
			<p class="eyebrow">{eyebrow}</p>
			<h1 id="page-title">{title}</h1>
			<p class="description">{description}</p>

			<div class="actions">
				<a class="primary-action" href="/fictional-worlds">Explore Fictional Worlds <span aria-hidden="true">→</span></a>
				<a class="secondary-action" href="/">Return home</a>
			</div>
		</div>

		<div class="status-card" aria-label="This section is under construction">
			<div class="icon" aria-hidden="true">{icon}</div>
			<div class="hard-hat" aria-hidden="true">🚧</div>
			<p class="status-label">Building in progress</p>
			<p class="status-title">Under construction</p>
			<div class="progress-track" aria-hidden="true"><span></span></div>
			<p class="status-note">New doors open soon.</p>
		</div>
	</section>

	<section class="coming-next" aria-labelledby="coming-next-title">
		<p class="section-kicker">A preview of what is ahead</p>
		<h2 id="coming-next-title">Worth the wait</h2>
		<div class="highlights">
			{highlights.map((highlight) => (
				<div class="highlight">
					<span aria-hidden="true">✦</span>
					<p>{highlight}</p>
				</div>
			))}
		</div>
	</section>
</main>

<style>
	.construction-page {
		--accent: #2563eb;
		--accent-deep: #1e40af;
		--accent-soft: rgba(37, 99, 235, 0.12);
		--surface: #eff6ff;
		max-width: 1120px;
		margin: 0 auto;
		padding: 4.5rem 1.5rem 5rem;
	}

	.construction-page.other-stuff {
		--accent: #db2777;
		--accent-deep: #c2410c;
		--accent-soft: rgba(219, 39, 119, 0.12);
		--surface: #fff7ed;
	}

	.construction-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
		padding: clamp(2rem, 5vw, 4.5rem);
		background:
			radial-gradient(circle at 95% 5%, var(--accent-soft), transparent 33%),
			linear-gradient(135deg, var(--surface), white 65%);
		border: 1px solid var(--accent-soft);
		border-radius: 28px;
		box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
	}

	.eyebrow,
	.section-kicker,
	.status-label {
		margin: 0 0 0.85rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1,
	h2,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 1.25rem;
		color: rgb(var(--black));
		font-size: clamp(2.5rem, 6vw, 4.75rem);
		line-height: 1;
		letter-spacing: -0.055em;
	}

	.description {
		max-width: 620px;
		margin-bottom: 2rem;
		color: rgb(var(--gray-dark));
		font-size: 1.15rem;
		line-height: 1.75;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.actions a {
		border-radius: 9px;
		padding: 0.8rem 1.25rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.actions a:hover {
		transform: translateY(-2px);
	}

	.primary-action {
		background: linear-gradient(135deg, var(--accent), var(--accent-deep));
		box-shadow: 0 8px 18px var(--accent-soft);
		color: white;
	}

	.secondary-action {
		border: 1px solid var(--accent-soft);
		color: var(--accent-deep);
	}

	.status-card {
		position: relative;
		overflow: hidden;
		padding: 2.25rem;
		background: white;
		border: 1px solid var(--accent-soft);
		border-radius: 20px;
		box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
		text-align: center;
	}

	.icon {
		font-size: 3.6rem;
		line-height: 1;
	}

	.hard-hat {
		position: absolute;
		top: 1rem;
		right: 1rem;
		font-size: 1.5rem;
	}

	.status-label {
		margin-top: 1.25rem;
		margin-bottom: 0.45rem;
	}

	.status-title {
		margin-bottom: 1.5rem;
		color: rgb(var(--black));
		font-size: 1.45rem;
		font-weight: 800;
	}

	.progress-track {
		height: 9px;
		overflow: hidden;
		background: var(--surface);
		border-radius: 999px;
	}

	.progress-track span {
		display: block;
		width: 68%;
		height: 100%;
		background: linear-gradient(90deg, var(--accent), var(--accent-deep));
		border-radius: inherit;
	}

	.status-note {
		margin: 1rem 0 0;
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
	}

	.coming-next {
		padding: 4.5rem 0 0;
		text-align: center;
	}

	h2 {
		margin-bottom: 2rem;
		color: rgb(var(--black));
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		letter-spacing: -0.035em;
	}

	.highlights {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.highlight {
		padding: 1.4rem;
		background: white;
		border: 1px solid var(--accent-soft);
		border-radius: 14px;
		box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
	}

	.highlight span {
		display: block;
		margin-bottom: 0.65rem;
		color: var(--accent);
		font-size: 1.15rem;
	}

	.highlight p {
		margin: 0;
		color: rgb(var(--gray-dark));
		line-height: 1.55;
	}

	@media (max-width: 760px) {
		.construction-page {
			padding: 2.5rem 1rem 3.5rem;
		}

		.construction-hero {
			grid-template-columns: 1fr;
			padding: 2rem;
		}

		.status-card {
			padding: 1.75rem;
		}

		.highlights {
			grid-template-columns: 1fr;
		}
	}
</style>
