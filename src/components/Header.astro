---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/fictional-worlds">Fictional Worlds</HeaderLink>
			<HeaderLink href="/real-world">Real World</HeaderLink>
			<HeaderLink href="/other-stuff">Other Stuff</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://twitter.com/cartooncampus" target="_blank" title="Follow CartoonCampus on Twitter">
				<span class="sr-only">Follow CartoonCampus on Twitter</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 11.075 2.5c-1.813 0-3.286 1.477-3.286 3.296 0 .26.03.51.09.75A9.335 9.335 0 0 1 1.67 3.15a3.28 3.28 0 0 0 1.018 4.382A3.28 3.28 0 0 1 .8 7.247v.041c0 1.596 1.124 2.92 2.622 3.224A3.283 3.283 0 0 1 .8 15.071c0 .155.015.31.041.458a9.321 9.321 0 0 0 5.218 1.461c6.26 0 9.655-5.106 9.655-9.334 0-.143-.011-.285-.033-.426a6.767 6.767 0 0 0 1.66-1.724z"
					></path></svg
				>
			</a>
			<a href="https://github.com/cartooncampus" target="_blank" title="CartoonCampus on GitHub">
				<span class="sr-only">Go to CartoonCampus GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 248, 255, 0.95) 100%);
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(0, 0, 0, 0.05);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1.5em;
		font-weight: 700;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		background: linear-gradient(135deg, #7c3aed, #2563eb);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		transition: all 0.3s ease;
	}

	h2 a:hover {
		opacity: 0.8;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75em 0;
		max-width: 1400px;
		margin: 0 auto;
	}

	.internal-links {
		display: flex;
		gap: 0;
		align-items: center;
	}

	nav a {
		padding: 0.75em 1.2em;
		color: rgb(var(--gray-dark));
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95em;
		transition: all 0.2s ease;
		position: relative;
	}

	nav a:hover {
		color: #7c3aed;
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: #7c3aed;
		color: #7c3aed;
	}

	.social-links,
	.social-links a {
		display: flex;
		gap: 0.5em;
	}

	.social-links a {
		padding: 0.5em;
		color: rgb(var(--gray-dark));
		transition: all 0.2s ease;
		border-radius: 8px;
	}

	.social-links a:hover {
		color: #7c3aed;
		background: rgba(124, 58, 237, 0.1);
		transform: translateY(-2px);
	}

	@media (max-width: 720px) {
		.social-links {
			display: none;
		}

		.internal-links {
			gap: 0;
			flex-wrap: wrap;
		}

		nav a {
			padding: 0.5em 0.75em;
			font-size: 0.9em;
		}

		h2 {
			font-size: 1.2em;
		}
	}
</style>
