---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-logo" href="/">
			<img src="/CC_Logo_Upscaled.png" alt="Cartoon Campus" />
		</a>
		<div class="internal-links">
			<HeaderLink href="/" class="deferred-link">Home</HeaderLink>
			<HeaderLink href="/fictional-worlds">Fictional Worlds</HeaderLink>
			<a href="https://store.cartooncampus.ca">Store</a>
			<HeaderLink href="/real-world" class="deferred-link">Real World</HeaderLink>
			<HeaderLink href="/other-stuff" class="deferred-link">Other Stuff</HeaderLink>
		</div>
		<div class="social-links">
			<a
				href="https://bsky.app/profile/cartooncampus.bsky.social"
				target="_blank"
				rel="noopener noreferrer"
				title="Follow Cartoon Campus on Bluesky"
			>
				<span class="sr-only">Follow Cartoon Campus on Bluesky</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
					<path
						fill="currentColor"
						d="M12 10.8c-1.1-2.1-4.1-6.1-6.8-8C2.6 1 1.6 1.3 1 1.6c-.7.3-1 1-1 1.6 0 .7.4 5.7.7 6.5.9 2.6 4.1 3.6 7 3.1-4.2.6-8 2.3-3.1 7.8 5.5 5.8 7.5-1.3 7.5-4.9 0 3.6 2 10.7 7.5 4.9 4.9-5.5 1.1-7.2-3.1-7.8 2.9.5 6.1-.5 7-3.1.3-.8.7-5.8.7-6.5 0-.6-.3-1.3-1-1.6-.6-.3-1.6-.6-4.2 1.2-2.7 1.9-5.7 5.9-6.8 8Z"
					/>
				</svg>
			</a>
			<a
				href="https://x.com/Cartoon_Campus"
				target="_blank"
				rel="noopener noreferrer"
				title="Follow Cartoon Campus on X"
			>
				<span class="sr-only">Follow Cartoon Campus on X</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M12.632 0h2.454L9.72 6.128 16 16h-4.916L7.235 10.838 2.77 16H.314l5.735-6.56L0 0h5.04l3.478 4.594L12.632 0Zm-.861 1.291-8.55 13.46h1.453l8.55-13.46h-1.453Zm-6.09 0H2.976l7.632 13.418h2.705L5.68 1.291Z"
					></path></svg
				>
			</a>
			<a
				href="https://github.com/cartooncampus"
				target="_blank"
				rel="noopener noreferrer"
				title="Cartoon Campus on GitHub"
			>
				<span class="sr-only">Go to CartoonCampus GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 248, 255, 0.95) 100%);
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(0, 0, 0, 0.05);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.site-logo {
		display: flex;
		align-items: center;
		padding: 0;
		border-bottom: 0;
	}

	.site-logo:hover {
		opacity: 0.8;
	}

	.site-logo img {
		display: block;
		width: auto;
		height: 48px;
		border-radius: 0;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75em 0;
		max-width: 1400px;
		margin: 0 auto;
	}

	.internal-links {
		display: flex;
		gap: 0;
		align-items: center;
	}

	nav a {
		padding: 0.75em 1.2em;
		color: rgb(var(--gray-dark));
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95em;
		transition: all 0.2s ease;
		position: relative;
	}

	nav a:hover {
		color: #7c3aed;
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: #7c3aed;
		color: #7c3aed;
	}

	.deferred-link {
		display: none;
	}

	.social-links,
	.social-links a {
		display: flex;
		gap: 0.5em;
	}

	.social-links a {
		padding: 0.5em;
		color: rgb(var(--gray-dark));
		transition: all 0.2s ease;
		border-radius: 8px;
	}

	.social-links a:hover {
		color: #7c3aed;
		background: rgba(124, 58, 237, 0.1);
		transform: translateY(-2px);
	}

	@media (max-width: 720px) {
		.social-links {
			display: none;
		}

		.internal-links {
			gap: 0;
			flex-wrap: wrap;
		}

		nav a {
			padding: 0.5em 0.75em;
			font-size: 0.9em;
		}

		.site-logo img {
			height: 38px;
		}
	}
</style>
